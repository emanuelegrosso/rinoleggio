@page
@model Rinoleggio.Web.Pages.Account.ProfileModel
@{
    ViewData["Title"] = "Il mio profilo";
}

<main class="form-page">
    <h1>Il mio profilo</h1>

    @if (TempData["StatusMessage"] is string status)
    {
        <p class="status-ok" role="status">@status</p>
    }

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <div class="field">
            <label asp-for="Input.FullName"></label>
            <input asp-for="Input.FullName" />
            <span asp-validation-for="Input.FullName"></span>
        </div>

        <div class="field">
            <label asp-for="Input.PhoneNumber"></label>
            <input asp-for="Input.PhoneNumber" />
            <span asp-validation-for="Input.PhoneNumber"></span>
            <p class="hint">Il telefono non viene mostrato negli annunci pubblici.</p>
        </div>

        <div class="field">
            <label asp-for="Input.AccountType"></label>
            <select asp-for="Input.AccountType" asp-items="Html.GetEnumSelectList<Rinoleggio.Domain.Enums.AccountType>()"></select>
        </div>

        @if (Model.PrivacyConsentAt is not null)
        {
            <p class="hint">Consenso privacy registrato il @Model.PrivacyConsentAt.Value.ToLocalTime().ToString("g").</p>
        }

        <button type="submit">Salva</button>
    </form>

    <p class="form-footer"><a asp-page="/Account/Index">← Torna all'account</a></p>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
