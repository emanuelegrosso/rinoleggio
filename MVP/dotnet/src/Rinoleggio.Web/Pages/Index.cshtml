@page
@model Rinoleggio.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Rinoleggio MVP";
}

<main>
    <h1>Rinoleggio — MVP contratti NLT</h1>
    <p>Inserisci un contratto in subentro e cercalo tra quelli pubblicati.</p>
    <p class="hero-actions">
        <a class="button" asp-page="/Contratti/Index">Cerca contratti</a>
        <a class="button secondary" asp-page="/Listings/Create">Inserisci contratto</a>
    </p>
    <p class="hint muted">Stack: ASP.NET Core 8, SQLite · DB: <code>@Model.DatabasePath</code></p>
</main>
