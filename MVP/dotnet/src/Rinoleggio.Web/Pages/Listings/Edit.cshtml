@page "{id:guid}"
@model Rinoleggio.Web.Pages.Listings.EditModel
@{
    ViewData["Title"] = "Modifica contratto";
}

<main class="form-page">
    <h1>Modifica contratto</h1>

    @if (TempData["StatusMessage"] is string status)
    {
        <p class="status-ok" role="status">@status</p>
    }

    <form method="post">
        <input type="hidden" asp-for="Input.ListingId" />
        <partial name="_ListingForm" model="Model" />
        <button type="submit">Salva e pubblica</button>
    </form>

    <p class="form-footer"><a asp-page="Index">← I miei contratti</a></p>
</main>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
