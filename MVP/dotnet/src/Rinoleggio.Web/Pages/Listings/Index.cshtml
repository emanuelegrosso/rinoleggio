@page
@model Rinoleggio.Web.Pages.Listings.IndexModel
@{
    ViewData["Title"] = "I miei contratti";
}

<main>
    <h1>I miei contratti</h1>
    <p><a asp-page="Create">+ Inserisci contratto</a></p>

    @if (!Model.Items.Any())
    {
        <p class="muted">Non hai ancora inserito contratti.</p>
    }
    else
    {
        <ul class="listing-list">
            @foreach (var item in Model.Items)
            {
                <li>
                    <strong>@item.Title</strong>
                    @if (item.IsPublished)
                    {
                        <span class="badge">Pubblicato</span>
                    }
                    else
                    {
                        <span class="badge muted">Non visibile</span>
                    }
                    @if (item.Contract is not null)
                    {
                        <span> · @item.Contract.MonthlyFee.ToString("C")/mese · @item.Contract.RemainingKm km residui</span>
                    }
                    <div>
                        <a asp-page="Edit" asp-route-id="@item.Id">Modifica</a>
                        @if (item.IsPublished)
                        {
                            <span> · </span>
                            <a asp-page="/Contratti/Detail" asp-route-id="@item.Id">Vedi in ricerca</a>
                        }
                    </div>
                </li>
            }
        </ul>
    }

    <p class="form-footer"><a asp-page="/Account/Index">← Account</a></p>
</main>
